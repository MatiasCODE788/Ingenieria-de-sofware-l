<mxfile host="app.diagrams.net" agent="draw.io" version="24.7.17" type="device" compressed="false">
  <diagram id="d0-porter" name="Cinco fuerzas de Porter">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="ttl" value="Cinco fuerzas de Porter - Minimarket AntuCayen" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#18324C;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1420" height="36" as="geometry"/></mxCell>
    <mxCell id="top" value="&lt;b&gt;Poder de negociación de los proveedores&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:17px&quot;&gt;• Variaciones de precios, condiciones de pago y disponibilidad de productos&lt;br&gt;• Stock variado por parte del distribuidor&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7B3F7B;fontColor=#18324C;fontSize=19;fontStyle=1;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="500" height="120" as="geometry"/></mxCell>
    <mxCell id="left" value="&lt;b&gt;Poder de negociación de los clientes&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:17px&quot;&gt;• Los clientes eligen dónde comprar&lt;br&gt;• Alternativas de pago, variedad de productos y mejor experiencia&lt;br&gt;• Responder a las necesidades del consumidor, manteniendo su preferencia&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D9B21F;fontColor=#18324C;fontSize=19;fontStyle=1;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="400" height="190" as="geometry"/></mxCell>
    <mxCell id="right" value="&lt;b&gt;Amenaza de nuevos competidores entrantes&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:17px&quot;&gt;• Apertura de negocios del mismo rubro&lt;br&gt;• La cercanía y confianza con clientes habituales es una ventaja&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B8301B;fontColor=#18324C;fontSize=19;fontStyle=1;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1060" y="380" width="400" height="190" as="geometry"/></mxCell>
    <mxCell id="bot" value="&lt;b&gt;Amenaza de productos sustitutos&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-weight:normal;font-size:17px&quot;&gt;• Negocios que reemplacen la demanda del minimarket, como compras en supermercado, comercio electrónico, aplicaciones con delivery y tiendas con horarios extendidos&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#3E8BC4;fontColor=#18324C;fontSize=19;fontStyle=1;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="500" y="750" width="500" height="130" as="geometry"/></mxCell>
    <mxCell id="ctr" value="&lt;b&gt;Rivalidad entre los competidores&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-weight:normal;font-size:17px&quot;&gt;• Supermercados, almacenes de barrio, botillerías y tiendas de conveniencia&lt;br&gt;• Obligación de mantener precios competitivos, stock variado y atención rápida y cercana&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7EEF6;strokeColor=#0B2E4F;strokeWidth=3;fontSize=20;fontColor=#0B2E4F;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="500" y="380" width="500" height="150" as="geometry"/></mxCell>
    <mxCell id="e1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=14;strokeWidth=4;strokeColor=#7B3F7B;" edge="1" parent="1" source="top" target="ctr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=14;strokeWidth=4;strokeColor=#D9B21F;" edge="1" parent="1" source="left" target="ctr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=14;strokeWidth=4;strokeColor=#B8301B;" edge="1" parent="1" source="right" target="ctr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=14;strokeWidth=4;strokeColor=#3E8BC4;" edge="1" parent="1" source="bot" target="ctr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="src" value="Fuente: Figura 3.2 original y descripción de la sección 3.2 del Documento 0." style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#6B7C8C;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1420" height="22" as="geometry"/></mxCell>
