<bpmn:collaboration id="Collab_Recepcion">
<bpmn:participant id="Part_Proveedor" name="Proveedor" processRef="Proc_Proveedor" />
<bpmn:participant id="Part_Minimarket" name="Minimarket Antucayen – Recepción con el sistema" processRef="Proc_Minimarket" />
<bpmn:messageFlow id="MsgFlow_1" name="Mercadería y factura" sourceRef="t2" targetRef="s0" />
</bpmn:collaboration>
<bpmn:process id="Proc_Proveedor" name="Proveedor" isExecutable="false">
<bpmn:startEvent id="p0" name="Inicio"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent>
<bpmn:manualTask id="t1" name="1. Preparar mercadería y factura"><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="t2" name="2. Entregar mercadería y factura"><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing></bpmn:manualTask>
<bpmn:endEvent id="p9" name="Entrega realizada"><bpmn:incoming>Flow_03</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_01" sourceRef="p0" targetRef="t1" />
<bpmn:sequenceFlow id="Flow_02" sourceRef="t1" targetRef="t2" />
<bpmn:sequenceFlow id="Flow_03" sourceRef="t2" targetRef="p9" />
</bpmn:process>
<bpmn:process id="Proc_Minimarket" name="Recepción de mercadería con el sistema" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_Bodeguero" name="Bodeguero"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>t12</bpmn:flowNodeRef><bpmn:flowNodeRef>t17</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef><bpmn:flowNodeRef>t18</bpmn:flowNodeRef><bpmn:flowNodeRef>g4</bpmn:flowNodeRef><bpmn:flowNodeRef>t20</bpmn:flowNodeRef><bpmn:flowNodeRef>g5</bpmn:flowNodeRef><bpmn:flowNodeRef>e3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Administrador" name="Administrador"><bpmn:flowNodeRef>t14</bpmn:flowNodeRef><bpmn:flowNodeRef>t15</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Sistema" name="Sistema Antucayen"><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t9</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef><bpmn:flowNodeRef>t10</bpmn:flowNodeRef><bpmn:flowNodeRef>t11</bpmn:flowNodeRef><bpmn:flowNodeRef>t13</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>t16</bpmn:flowNodeRef><bpmn:flowNodeRef>t19</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef><bpmn:flowNodeRef>t21</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Llega el proveedor"><bpmn:outgoing>Flow_04</bpmn:outgoing><bpmn:messageEventDefinition id="s0_msg" /></bpmn:startEvent>
<bpmn:manualTask id="t3" name="3. Recibir mercadería y factura"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="t4" name="4. Contar y revisar la mercadería física"><bpmn:incoming>Flow_05</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="t5" name="5. Cargar factura (PDF o foto) y analizarla"><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t6" name="6. Extraer folio, fecha, total e ítems (PDF, OCR, Excel, CSV)"><bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="t7" name="7. Revisar datos extraídos y guardar factura"><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t8" name="8. Validar número único por proveedor"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g1" name="¿Número duplicado?" gatewayDirection="Diverging"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="t9" name="9. Alertar factura duplicada"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="e1" name="Factura ya registrada"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="t10" name="10. Registrar factura e ítems y archivar documento"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:dataOutputAssociation id="DataAssoc_1"><bpmn:targetRef>doc</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="t11" name="11. Resolver SKU por equivalencia (ítem a ítem)"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics /></bpmn:serviceTask>
<bpmn:userTask id="t12" name="12. Procesar factura"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t13" name="13. Ingresar stock de ítems válidos y registrar movimiento"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:dataOutputAssociation id="DataAssoc_2"><bpmn:targetRef>db</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g2" name="¿Quedan ítems observados?" gatewayDirection="Diverging"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t14" name="14. Registrar equivalencia o crear producto"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="t15" name="15. Autorizar reproceso de la factura"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t16" name="16. Mostrar resumen del procesamiento"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="t17" name="17. Comparar resumen con la mercadería contada"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="g3" name="¿Recepción conforme?" gatewayDirection="Diverging"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t18" name="18. Marcar factura como Observada y ajustar inventario"><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t19" name="19. Registrar ajuste de inventario"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="e2" name="Recepción con observaciones"><bpmn:incoming>Flow_27</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="g4" name="¿Exportar ítems?" gatewayDirection="Diverging"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing><bpmn:outgoing>Flow_29</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="t20" name="20. Exportar ítems válidos a Excel o CSV"><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_30</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="t21" name="21. Generar archivo y registrar auditoría"><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g5" name="" gatewayDirection="Converging"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e3" name="Recepción finalizada"><bpmn:incoming>Flow_32</bpmn:incoming></bpmn:endEvent>
