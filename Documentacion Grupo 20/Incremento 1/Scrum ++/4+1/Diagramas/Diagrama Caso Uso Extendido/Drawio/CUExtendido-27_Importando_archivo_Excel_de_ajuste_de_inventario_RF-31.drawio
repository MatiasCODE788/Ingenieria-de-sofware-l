<mxfile host="app.diagrams.net" agent="draw.io" version="24.7.17" type="device" compressed="false">
  <diagram id="ext-cu-27" name="CU-27 Flujo extendido">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1255" math="0" shadow="0">
      <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="ttl" value="CU-27 — Importando archivo Excel de ajuste de inventario - RF-31" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#18324C;" vertex="1" parent="1"><mxGeometry x="60" y="28" width="1580" height="44" as="geometry"/></mxCell>
    <mxCell id="sub" value="DIAGRAMA DE ACTIVIDADES DEL CASO DE USO · ESPECIFICACIÓN EXTENDIDA" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#48647D;" vertex="1" parent="1"><mxGeometry x="60" y="76" width="1580" height="26" as="geometry"/></mxCell>
    <mxCell id="actor" value="Administrador / Bodeguero" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#18324C;strokeColor=#254762;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="60" height="90" as="geometry"/></mxCell>
    <mxCell id="start" value="" style="ellipse;html=1;fillColor=#1F3A5C;strokeColor=#1F3A5C;" vertex="1" parent="1"><mxGeometry x="624" y="140" width="32" height="32" as="geometry"/></mxCell>
    <mxCell id="step1" value="1. El sistema recibe la ruta del archivo seleccionado por el usuario." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="215" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step2" value="2. El sistema invoca CU-28 para validar que el tamaño del archivo no exceda 10 MB." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="325" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step3" value="3. El sistema invoca CU-29 para verificar que la primera fila contenga las columnas &#39;SKU&#39; y &#39;cantidad&#39;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="435" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step4" value="4. El sistema registra la carga en la tabla log_archivo - nombre de archivo, fecha y hora, usuario y resultado de validación." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="545" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step5" value="5. El sistema lee las filas del archivo y construye la lista de ajustes propuestos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="655" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step6" value="6. El sistema invoca CU-34 para verificar la existencia de cada SKU en el maestro de productos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="765" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step7" value="7. El sistema invoca CU-31 para mostrar la previsualización del ajuste." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="875" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#ffffff;strokeColor=#1F3A5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="622" y="995" width="36" height="36" as="geometry"/></mxCell>
    <mxCell id="e1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="start" target="step1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e5" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step4" target="step5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e6" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step5" target="step6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e7" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step6" target="step7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e8" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step7" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="alt1" value="2a. El archivo supera 10 MB. CU-28 retorna error. El sistema muestra &#39;El archivo supera el límite de 10 MB&#39;. El caso de uso termina sin registrar en log_archivo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#5A3B00;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1010" y="320" width="480" height="73" as="geometry"/></mxCell>
    <mxCell id="e9" value="2a" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step2" target="alt1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="357"/><mxPoint x="980" y="356"/></Array></mxGeometry></mxCell>
    <mxCell id="altend1" value="" style="ellipse;html=1;shape=endState;fillColor=#ffffff;strokeColor=#1F3A5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1530" y="338" width="36" height="36" as="geometry"/></mxCell>
    <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt1" target="altend1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="alt2" value="3a. La estructura de columnas es inválida. CU-30 retorna error. El sistema muestra &#39;Estructura inválida: faltan las columnas SKU o cantidad&#39;. El caso de uso termina." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#5A3B00;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1010" y="430" width="480" height="73" as="geometry"/></mxCell>
    <mxCell id="e11" value="3a" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step3" target="alt2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="467"/><mxPoint x="980" y="466"/></Array></mxGeometry></mxCell>
    <mxCell id="altend2" value="" style="ellipse;html=1;shape=endState;fillColor=#ffffff;strokeColor=#1F3A5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1530" y="448" width="36" height="36" as="geometry"/></mxCell>
    <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt2" target="altend2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="alt3" value="6a. Algunos SKU no existen en la BD. CU-34 los marca como &#39;SKU no encontrado&#39;. El procesamiento continúa para los SKU válidos y los no encontrados se listan en la previsualización." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#5A3B00;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1010" y="760" width="480" height="73" as="geometry"/></mxCell>
    <mxCell id="e13" value="6a" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step6" target="alt3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="797"/><mxPoint x="980" y="796"/></Array></mxGeometry></mxCell>
    <mxCell id="e14" value="continúa" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt3" target="step7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="legend" value="El flujo se basa exclusivamente en la especificación extendida del documento. No se agregan flujos no definidos en ella." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#48647D;" vertex="1" parent="1"><mxGeometry x="320" y="1125" width="700" height="30" as="geometry"/></mxCell>
    <mxCell id="source" value="Fuente: Tabla 2.31, §2.7.3, del documento del Incremento 1." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7C8C;" vertex="1" parent="1"><mxGeometry x="320" y="1160" width="700" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
