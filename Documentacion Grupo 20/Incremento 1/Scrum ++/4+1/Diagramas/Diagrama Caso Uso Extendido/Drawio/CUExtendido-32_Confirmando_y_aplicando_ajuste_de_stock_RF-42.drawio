<mxfile host="app.diagrams.net" agent="draw.io" version="24.7.17" type="device" compressed="false">
  <diagram id="ext-cu-32" name="CU-32 Flujo extendido">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1264" math="0" shadow="0">
      <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="ttl" value="CU-32 — Confirmando y aplicando ajuste de stock - RF-42" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#18324C;" vertex="1" parent="1"><mxGeometry x="60" y="28" width="1580" height="44" as="geometry"/></mxCell>
    <mxCell id="sub" value="DIAGRAMA DE ACTIVIDADES DEL CASO DE USO · ESPECIFICACIÓN EXTENDIDA" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#48647D;" vertex="1" parent="1"><mxGeometry x="60" y="76" width="1580" height="26" as="geometry"/></mxCell>
    <mxCell id="actor" value="Administrador / Bodeguero" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#18324C;strokeColor=#254762;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="60" height="90" as="geometry"/></mxCell>
    <mxCell id="start" value="" style="ellipse;html=1;fillColor=#1F3A5C;strokeColor=#1F3A5C;" vertex="1" parent="1"><mxGeometry x="624" y="140" width="32" height="32" as="geometry"/></mxCell>
    <mxCell id="step1" value="1. El sistema inicia una transacción en la BD." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="215" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step2" value="2. Para cada ítem válido, el sistema ejecuta la actualización de stock según la modalidad: UPDATE producto SET stock = stock + cantidad, Suma, o UPDATE producto SET stock = cantidad - Reemplazo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="325" width="520" height="73" as="geometry"/></mxCell>
    <mxCell id="step3" value="3. El sistema verifica que el stock resultante no sea negativo; si lo fuera, registra la fila como &#39;Observación: stock resultante negativo&#39;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="444" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step4" value="4. El sistema confirma la transacción con COMMIT." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="554" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step5" value="5. El sistema invoca CU-33 para registrar el historial de cambios." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="664" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step6" value="6. El sistema muestra el mensaje &#39;¡Ajuste aplicado exitosamente! N productos actualizados&#39;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="774" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step7" value="7. El sistema redirige al usuario al Historial de Ajustes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="884" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#ffffff;strokeColor=#1F3A5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="622" y="1004" width="36" height="36" as="geometry"/></mxCell>
    <mxCell id="e1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="start" target="step1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e5" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step4" target="step5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e6" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step5" target="step6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e7" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step6" target="step7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e8" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step7" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="alt1" value="2a. Se produce un error en la BD durante el UPDATE. El sistema ejecuta ROLLBACK y muestra &#39;Error al aplicar el ajuste. No se realizaron cambios&#39;. El historial no se registra." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#5A3B00;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1010" y="325" width="480" height="73" as="geometry"/></mxCell>
    <mxCell id="e9" value="2a" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step2" target="alt1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="361"/><mxPoint x="980" y="361"/></Array></mxGeometry></mxCell>
    <mxCell id="altend1" value="" style="ellipse;html=1;shape=endState;fillColor=#ffffff;strokeColor=#1F3A5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1530" y="343" width="36" height="36" as="geometry"/></mxCell>
