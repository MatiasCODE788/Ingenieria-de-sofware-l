    <mxCell id="legend" value="El flujo se basa exclusivamente en la especificación extendida del documento. No se agregan flujos no definidos en ella." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#48647D;" vertex="1" parent="1"><mxGeometry x="320" y="1134" width="700" height="30" as="geometry"/></mxCell>
