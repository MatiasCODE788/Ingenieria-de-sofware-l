<mxfile host="app.diagrams.net" agent="draw.io" version="24.7.17" type="device" compressed="false">
  <diagram id="ext-cu-01" name="CU-01 Flujo extendido">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1365" math="0" shadow="0">
      <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="ttl" value="CU-01 — Registrando producto - RF-01" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#18324C;" vertex="1" parent="1"><mxGeometry x="60" y="28" width="1580" height="44" as="geometry"/></mxCell>
    <mxCell id="sub" value="DIAGRAMA DE ACTIVIDADES DEL CASO DE USO · ESPECIFICACIÓN EXTENDIDA" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#48647D;" vertex="1" parent="1"><mxGeometry x="60" y="76" width="1580" height="26" as="geometry"/></mxCell>
    <mxCell id="actor" value="Administrador / Bodeguero" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontColor=#18324C;strokeColor=#254762;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="60" height="90" as="geometry"/></mxCell>
    <mxCell id="start" value="" style="ellipse;html=1;fillColor=#1F3A5C;strokeColor=#1F3A5C;" vertex="1" parent="1"><mxGeometry x="624" y="140" width="32" height="32" as="geometry"/></mxCell>
    <mxCell id="step1" value="1. El sistema despliega el formulario de alta de producto - SKU, nombre, código de barras, unidad de medida, precio unitario y stock inicial." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="215" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step2" value="2. El usuario completa los campos obligatorios SKU, nombre y unidad de medida." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="325" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step3" value="3. El usuario presiona el botón &#39;Guardar&#39;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="435" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step4" value="4. El sistema invoca CU-02 para validar la unicidad del SKU." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="545" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step5" value="5. El sistema invoca CU-07 para validar la unicidad del código de barras." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="655" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step6" value="6. Si ambas validaciones son exitosas, el sistema ejecuta INSERT INTO producto con los datos ingresados." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="765" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step7" value="7. El sistema muestra el mensaje &#39;Producto registrado correctamente&#39;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="875" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="step8" value="8. El formulario se limpia y queda disponible para registrar otro producto." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDF4FF;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#18324C;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="380" y="985" width="520" height="64" as="geometry"/></mxCell>
    <mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#ffffff;strokeColor=#1F3A5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="622" y="1105" width="36" height="36" as="geometry"/></mxCell>
    <mxCell id="e1" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="start" target="step1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e2" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e3" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e4" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e5" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step4" target="step5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e6" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step5" target="step6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e7" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step6" target="step7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e8" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step7" target="step8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="e9" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4A6FA5;" edge="1" parent="1" source="step8" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="alt1" value="3a. El usuario no completa un campo obligatorio. El sistema resalta los campos vacíos en rojo e impide la ejecución del guardado." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#5A3B00;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1010" y="435" width="480" height="64" as="geometry"/></mxCell>
    <mxCell id="e10" value="3a" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step3" target="alt1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="467"/><mxPoint x="980" y="467"/></Array></mxGeometry></mxCell>
    <mxCell id="altend1" value="" style="ellipse;html=1;shape=endState;fillColor=#ffffff;strokeColor=#1F3A5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1530" y="449" width="36" height="36" as="geometry"/></mxCell>
    <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt1" target="altend1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="alt2" value="4a. El SKU ya existe en la BD. CU-02 retorna error. El sistema muestra el campo SKU en rojo con el mensaje &#39;El SKU ya existe en el sistema&#39;. El caso de uso termina." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#5A3B00;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1010" y="540" width="480" height="73" as="geometry"/></mxCell>
    <mxCell id="e12" value="4a" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step4" target="alt2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="577"/><mxPoint x="980" y="576"/></Array></mxGeometry></mxCell>
    <mxCell id="altend2" value="" style="ellipse;html=1;shape=endState;fillColor=#ffffff;strokeColor=#1F3A5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1530" y="558" width="36" height="36" as="geometry"/></mxCell>
    <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt2" target="altend2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="alt3" value="5a. El código de barras ya pertenece a otro producto. Se invoca CU-08 que despliega el mensaje &#39;Código de barras ya registrado para otro producto&#39;. El caso de uso termina." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF4E5;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#5A3B00;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1010" y="650" width="480" height="73" as="geometry"/></mxCell>
    <mxCell id="e14" value="5a" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step5" target="alt3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="687"/><mxPoint x="980" y="686"/></Array></mxGeometry></mxCell>
    <mxCell id="altend3" value="" style="ellipse;html=1;shape=endState;fillColor=#ffffff;strokeColor=#1F3A5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1530" y="668" width="36" height="36" as="geometry"/></mxCell>
    <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#D79B00;fontSize=12;fontStyle=1;fontColor=#8A5A00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alt3" target="altend3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
    <mxCell id="legend" value="El flujo se basa exclusivamente en la especificación extendida del documento. No se agregan flujos no definidos en ella." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#48647D;" vertex="1" parent="1"><mxGeometry x="320" y="1235" width="700" height="30" as="geometry"/></mxCell>
    <mxCell id="source" value="Fuente: Tabla 2.29, §2.7.1, del documento del Incremento 1." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#6B7C8C;" vertex="1" parent="1"><mxGeometry x="320" y="1270" width="700" height="24" as="geometry"/></mxCell>
