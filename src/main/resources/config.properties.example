# Solo PLANTILLA. No se incluye un archivo config.properties con credenciales en el JAR.
# La opción "Configurar conexión" en el inicio de sesión guarda la configuración
# específica para el PC en ~/.antucayen/config.properties.
# Usar UNA IP fija/reservada para el computador administrador, NO la del cajero.
# EJEMPLO: reemplazar 192.168.100.10 por la IP real del servidor.
db.host=192.168.100.10
db.port=3306
db.nombre=minimarket
db.usuario=antucayen_app
db.contrasena=CAMBIAR_CONTRASENA
# Configurar TLS en el servidor y clientes antes de activar.
db.ssl=false
